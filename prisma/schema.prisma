datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model StoreSettings {
  id                  String   @id @default("default")
  storeName           String   @default("Aura Mart")
  tagline             String   @default("Quality Products Delivered to Your Doorstep")
  announcementText    String   @default("🚚 Cash on Delivery Available Nationwide! Fast Express Shipping.")
  supportPhone        String   @default("01700000000")
  bkashNumber         String   @default("01700000000 (Personal/Send Money)")
  nagadNumber         String   @default("01700000000 (Personal/Send Money)")
  insideCityDelivery  Float    @default(60)
  outsideCityDelivery Float    @default(120)
  currencySymbol      String   @default("৳")
  updatedAt           DateTime @updatedAt
}

model Product {
  id             String      @id @default(uuid())
  name           String
  slug           String      @unique
  description    String
  category       String      @default("General")
  price          Float
  compareAtPrice Float?
  stock          Int         @default(0)
  imageUrl       String
  isFeatured     Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@index([category, isActive])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerName    String
  customerPhone   String
  shippingAddress String
  deliveryZone    String      @default("Inside City")
  deliveryCharge  Float       @default(60)
  subtotal        Float
  totalAmount     Float
  paymentMethod   String      @default("COD")
  paymentSenderNo String?
  trxId           String?
  orderNote       String?
  status          String      @default("Pending")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([customerPhone])
  @@index([status, createdAt])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String?
  productName     String
  productImage    String
  quantity        Int
  priceAtPurchase Float

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}
