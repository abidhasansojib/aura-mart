datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  name      String   @default("Admin")
  role      String   @default("superadmin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSettings {
  id                  String   @id @default("default")
  storeName           String   @default("Aura Mart")
  tagline             String   @default("Quality Products Delivered to Your Doorstep")
  announcementText    String   @default("🚚 Cash on Delivery Available Nationwide! Fast Express Shipping.")
  supportPhone        String   @default("01700000000")
  bkashNumber         String   @default("01700000000 (Personal/Send Money)")
  nagadNumber         String   @default("01700000000 (Personal/Send Money)")
  insideCityDelivery  Float    @default(60)
  outsideCityDelivery Float    @default(120)
  currencySymbol      String   @default("৳")

  // Hero & Bento Promotional Content
  heroBadgeText       String   @default("Featured Collection 2026")
  heroTitle           String   @default("Aura Mart")
  heroTagline         String   @default("Quality Products Delivered to Your Doorstep. Zero advance payment required.")
  heroCtaText         String   @default("Shop Catalog")
  heroBadgeSecondary  String   @default("Cash on Delivery Available")

  // Bento Cards Content
  expressCardTitle    String   @default("Fast Doorstep Delivery")
  expressCardSubtitle String   @default("All 64 Districts Dispatched in 24-48 Hours")
  guaranteeCardTitle  String   @default("Open-Box Inspection")
  guaranteeCardSubtitle String @default("Check your parcel in front of the delivery agent before paying cash.")

  // Social & WhatsApp Integration
  whatsappNumber      String   @default("01700000000")
  facebookUrl         String   @default("")
  instagramUrl        String   @default("")

  // Payment Gateways Toggles
  enableCod           Boolean  @default(true)
  enableBkash         Boolean  @default(true)
  enableNagad         Boolean  @default(true)
  enableRocket        Boolean  @default(false)
  rocketNumber        String   @default("")

  // Free Shipping & Inventory Rules
  freeShippingThreshold Float  @default(0)
  lowStockThreshold     Int    @default(5)

  // Store Status
  isStoreOpen         Boolean  @default(true)
  storeClosedNotice   String   @default("We are currently restocking our inventory. Orders will resume shortly!")

  updatedAt           DateTime @updatedAt
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue Float
  minOrderValue Float     @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([code, isActive])
}

model Product {
  id             String      @id @default(uuid())
  name           String
  slug           String      @unique
  description    String
  category       String      @default("General")
  price          Float
  compareAtPrice Float?
  stock          Int         @default(0)
  imageUrl       String
  isFeatured     Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@index([category, isActive])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerName    String
  customerPhone   String
  shippingAddress String
  deliveryZone    String      @default("Inside City")
  deliveryCharge  Float       @default(60)
  subtotal        Float
  discountAmount  Float       @default(0)
  couponCode      String?
  totalAmount     Float
  paymentMethod   String      @default("COD")
  paymentSenderNo String?
  trxId           String?
  orderNote       String?
  status          String      @default("Pending")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([customerPhone])
  @@index([status, createdAt])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String?
  productName     String
  productImage    String
  quantity        Int
  priceAtPurchase Float

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}
